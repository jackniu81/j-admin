# J-Admin 服务端环境变量示例
# 复制为 server/.env 后按需修改；file 模式下全部留空也能零配置启动。
# cp server/.env.example server/.env

# ---- 数据源驱动：file（默认，文件数据库，免安装）| postgres ----
DB_DRIVER=file

# ---- file 模式：JSON 数据库文件路径（相对 server 工作目录，即 server/data/db.json）----
DB_FILE=./data/db.json

# ---- postgres 模式：DB_DRIVER=postgres 时 PG_PASSWORD 必填 ----
# 建库：CREATE DATABASE j_admin;  表结构由启动时自动迁移，或 npm run db:migrate -w server
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=j_admin

# ---- JWT 鉴权 ----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=2h

# ---- HTTP 端口 ----
PORT=3000
