# 复制为 server/.env 后按需修改；file 模式下全部留空也能零配置启动（spec §3.1）

# 数据源：file | postgres（唯一切换开关，默认 file）
DB_DRIVER=file
# file 模式存储路径（相对 server 目录）
DB_FILE=./data/db.json

# postgres 模式（DB_DRIVER=postgres 时 PG_PASSWORD 必填，缺失则启动报错）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=j_admin

# JWT（生产必须覆盖 JWT_SECRET）
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=2h

# 服务端口
PORT=3000
